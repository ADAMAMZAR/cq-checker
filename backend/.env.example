# ── Google Cloud / Firebase Firestore ─────────────────────────
GCP_PROJECT_ID=gen-lang-client-0447597759
FIRESTORE_DATABASE=(default)

# ── Microsoft Entra ID (SSO) ──────────────────────────────────
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
ENTRA_VERIFY_SSL=false

# ── Session Management ────────────────────────────────────────
